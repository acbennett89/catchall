 "name": "Cutoff Dates to Change C&P Payment Method",
 "content": "<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" style=\"height:59px; width:637px\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td colspan=\"2\" style=\"background-color:#aaaaaa\">\n\t\t\t<p style=\"margin-bottom:0pt; margin-right:0in; margin-top:0in; text-align:center\"><span style=\"font-family:Arial\"><span style=\"font-size:24px\"><strong>November 1</strong></span></span></p>\n\n\t\t\t<p style=\"margin-bottom:0pt; margin-right:0in; margin-top:0in; text-align:center\"><span style=\"color:navy; font-family:Arial; font-size:20pt\"><span style=\"font-family:Arial\"><strong><span style=\"color:black; font-family:&quot;Book Antiqua&quot;,serif; font-size:18pt; text-decoration:none\"><span style=\"font-family:Arial\">Recurring Payment</span></span></strong></span></span><span style=\"color:#ff0000\"><span style=\"font-family:Arial; font-size:20pt\"><span style=\"font-family:Arial\"><strong><span style=\"font-family:&quot;Book Antiqua&quot;,serif; font-size:18pt; text-decoration:none\">*</span></strong></span></span></span><span style=\"color:navy; font-family:Arial; font-size:20pt\">&nbsp;</span></p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td colspan=\"2\" style=\"text-align:center\"><span style=\"font-size:16px\"><strong><span style=\"color:#000080\"><span style=\"font-family:Arial\">VETSNET</span><span style=\"font-family:Book Antiqua\"> </span><span style=\"font-family:Arial\">AWARDS</span></span></strong></span></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<p style=\"text-align:center\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong><span style=\"color:#000080\">All Changes</span></strong></span></span></p>\n\t\t\t</td>\n\t\t\t<td>\n\t\t\t<p style=\"text-align:center\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><span style=\"color:#000080\"><em><strong><span style=\"background-color:#ffff00\">By COB</span></strong></em></span></span></span><br />\n\t\t\t<span style=\"f