{
 "name": "M21-1, Part II, Subpart iii, Chapter 2, Section D - Claims Based on Reports of Examination or Hospitalization",
 "content": "<div style=\"text-align: right\"><span style=\"font-size: 11px\"><span style=\"font-family: arial , helvetica , sans-serif\"><a class=\"eGainArticleLink\" articleid=\"554400000174875\" articlename=\"M21-1, Part II, Subpart iii, Chapter 2, Section C - Claims for Increase\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174875?portalId=554400000001018&usertype=customer&\">&lt;-- Previous Section</a>&nbsp;&nbsp;<a class=\"eGainArticleLink\" articleid=\"554400000174877\" articlename=\"M21-1, Part II, Subpart iii, Chapter 2, Section E - Incorrectly Established Claims\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174877?portalId=554400000001018&usertype=customer&\">Next Section--&gt;</a></span></span></div><h2><span style=\"font-family: arial, helvetica, sans-serif\"><a id=\"top\" name=\"top\"><strong><span style=\"font-size: 16px\">Overview</span></strong></a></span></h2><div style=\"margin-left: 85pt\"><hr /></div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\t<tbody>\t\t<tr>\t\t\t<td style=\"width: 115px; vertical-align: top\">\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><strong><span style=\"font-size: 14px\">In This Section</span></strong></span></h3>\t\t\t</td>\t\t\t<td style=\"height: 8px; width: 15px\"></td>\t\t\t<td style=\"width: 516px\">\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial , helvetica , sans-serif\">This section contains the following topics:</span></span></div>\t\t\t<div></div>\t\t\t<table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 496px\" summary=\"Column 1 has the topic number and column 2 has the topic title.\">\t\t\t\t<thead>\t\t\t\t\t<tr>\t\t\t\t\t\t<th scope=\"col\" style=\"width: 86px\">\t\t\t\t\t\t<div style=\"text-align: center\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><strong>Topic</strong></span></span></div>\t\t\t\t\t\t</th>\t\t\t\t\t\t<th scope=\"col\" style=\"width: 423px\">\t\t\t\t\t\t<div style=\"text-align: center\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><strong>Topic Name</strong></span></span></div>\t\t\t\t\t\t</th>\t\t\t\t\t</tr>\t\t\t\t</thead>\t\t\t\t<tbody>\t\t\t\t\t<tr>\t\t\t\t\t\t<td style=\"width: 86px; vertical-align: top\">\t\t\t\t\t\t<div align=\"center\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">1</span></span></div>\t\t\t\t\t\t</td>\t\t\t\t\t\t<td style=\"width: 423px; vertical-align: top\">\t\t\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><a href=\"#1\"><span style=\"font-size: 14px\">Claims Based on Reports of Examination or Hospitalization</span></a></span></div>\t\t\t\t\t\t</td>\t\t\t\t\t</tr>\t\t\t\t\t<tr>\t\t\t\t\t\t<td style=\"width: 86px; vertical-align: top\">\t\t\t\t\t\t<div align=\"center\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">2</span></span></div>\t\t\t\t\t\t</td>\t\t\t\t\t\t<td style=\"width: 423px; vertical-align: top\">\t\t\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><a href=\"#2\"><span style=\"font-size: 14px\">Claims Based on Reports of Examination or Hospitalization Prior to March 24, 2015 </span></a></span></div>\t\t\t\t\t\t</td>\t\t\t\t\t</tr>\t\t\t\t</tbody>\t\t\t</table>\t\t\t<div></div>\t\t\t</td>\t\t</tr>\t</tbody>\t<tbody>\t</tbody></table><div style=\"margin-left: 1.2in\"><hr /><p></p></div><h2><span style=\"font-family: arial, helvetica, sans-serif\"><strong><span style=\"font-size: 16px\">1<a id=\"1\" name=\"1\">.</a>&nbsp; Claims Based on Reports of Examination or Hospitalization</span></strong></span></h2><p></p><div style=\"margin-left: 1.2in\"><hr /></div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\t<tbody>\t\t<tr>\t\t\t<td style=\"width: 115px; vertical-align: top\">\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><strong><span style=\"font-size: 14px\">Introduction</span></strong></span></h3>\t\t\t</td>\t\t\t<td style=\"height: 8px; width: 15px\"></td>\t\t\t<td style=\"width: 516px\">\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">This topic contains information on reviewing reports of examination or hospitalization at Department of Veterans Affairs (VA) facilities, military treatment facilities (MTFs), or private healthcare facilities to determine whether claims action is warranted, including</span></span></div>\t\t\t<ul>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><a href=\"#1a\">handling notice of a report of VA or MTF examination or hospitalization occurring on or after March 24, 2015</a>, and</span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><a href=\"#1b\">considering evidence of VA or MTF examination or hospitalization occurring on or after March 24, 2015</a></span></span><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">.</span></span></div>\t\t\t\t</li>\t\t\t</ul>\t\t\t</td>\t\t</tr>\t</tbody></table><div style=\"margin-left: 85pt\"><hr /></div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\t<tbody>\t\t<tr>\t\t\t<td style=\"width: 115px; vertical-align: top\">\t\t\t<h3><strong><span style=\"font-size: 14px\"><span style=\"font-family: arial , helvetica , sans-serif\">Change Date</span></span></strong></h3>\t\t\t</td>\t\t\t<td style=\"height: 8px; width: 15px\"></td>\t\t\t<td style=\"width: 516px\">\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial , helvetica , sans-serif\">June 24, 2021</span></span></div>\t\t\t</td>\t\t</tr>\t</tbody></table><div style=\"margin-left: 85pt\"><hr /></div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\t<tbody>\t\t<tr>\t\t\t<td style=\"width: 115px; vertical-align: top\">\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><strong><span style=\"font-size: 14px\"><span style=\"font-size: 14px\">II.iii.2.D.1.a<a id=\"1a\" name=\"1a\">.</a> Handling Notice of a Report of VA or MTF Examination or Hospitalization Occurring on or After March 24, 2015</span></span></strong></span></span></span></h3>\t\t\t</td>\t\t\t<td style=\"width: 15px; vertical-align: top\"></td>\t\t\t<td style=\"width: 516px\">\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">Notice of examination in a Department of Veterans Affairs (VA) facility or military treatment facility (MTF) occurring on or after March 24, 2015, is <strong><em>not</em></strong> a claim.&nbsp; The date of examination will be considered for effective date purposes if a complete claim or intent to file (ITF) is received within one year from the date of examination or hospitalization for the following:&nbsp;</span></span></div>\t\t\t<ul>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">a claim for an increased disability evaluation received for one or more conditions treated as part of the examination or hospitalization, or</span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">pension, when entitlement to pension was previously denied based on the absence of evidence of permanent and total (P&amp;T) disability.&nbsp;</span></span></div>\t\t\t\t</li>\t\t\t</ul>\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><strong><em>Important</em></strong>:&nbsp; Notice of hospitalization in a VA facility occurring on or after March 24, 2015, <em>will</em> result in an adjudicative determination as to entitlement to a temporary evaluation under <a href=\"http://www.ecfr.gov/cgi-bin/text-idx?SID=a0930b647c72eebf00d9e309059afa68&amp;mc=true&amp;node=se38.1.4_129&amp;rgn=div8\" target=\"_blank\">38 CFR 4.29</a> or <a href=\"http://www.ecfr.gov/cgi-bin/text-idx?SID=a0930b647c72eebf00d9e309059afa68&amp;mc=true&amp;node=se38.1.4_130&amp;rgn=div8\" target=\"_blank\">38 CFR 4.30</a> as discussed in <a class=\"eGainArticleLink\" articleid=\"554400000177479\" articlename=\"M21-1, Part VIII, Subpart iv, Chapter 8, Section B - Hospitalization Ratings Under 38 CFR 4.29\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000177479?portalId=554400000001018&usertype=customer&\">M21-1, Part VIII, Subpart iv, 8.B</a> and <a class=\"eGainArticleLink\" articleid=\"554400000177542\" articlename=\"M21-1, Part VIII, Subpart iv, Chapter 8, Section C - Convalescent Ratings Under 38 CFR 4.30\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000177542?portalId=554400000001018&usertype=customer&\">C</a>.&nbsp; However, a report of hospitalization will only result in adjudicative action applicable to disabilities which are currently service-connected (SC) when a rating under <a href=\"http://www.ecfr.gov/cgi-bin/text-idx?SID=a0930b647c72eebf00d9e309059afa68&amp;mc=true&amp;node=se38.1.4_129&amp;rgn=div8\" target=\"_blank\">38 CFR 4.29</a> or <a href=\"http://www.ecfr.gov/cgi-bin/text-idx?SID=a0930b647c72eebf00d9e309059afa68&amp;mc=true&amp;node=se38.1.4_130&amp;rgn=div8\" target=\"_blank\">38 CFR 4.30</a> can be granted.&nbsp;&nbsp; </span></span></div>\t\t\t<div></div>\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><strong><em>Note</em></strong>:&nbsp; </span></span><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">A report of VA examination or hospitalization occurring on or after March 24, 2015, showing a nursing home stay is not sufficient to grant aid and attendance (A&amp;A) without a formal application.</span></span></div>\t\t\t<div></div>\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><strong><em>References</em></strong>:&nbsp; For more information on </span></span></div>\t\t\t<ul>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">considering reports of examination or hospitalization for effective date purposes in subsequent claims, see <a href=\"#1b\">M21-1, Part II, Subpart iii, 2.D.1.b</a>, and</span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">prescribed form requirements for a grant of A&amp;A, see <a class=\"eGainArticleLink\" articleid=\"554400000174869\" articlename=\"M21-1, Part II, Subpart iii, Chapter 1, Section A - Applications for Benefits\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174869?portalId=554400000001018&usertype=customer&\">M21-1, Part II, Subpart iii, 1.A.3</a>.</span></span></div>\t\t\t\t</li>\t\t\t</ul>\t\t\t</td>\t\t</tr>\t</tbody></table><div style=\"margin-left: 85pt\"><hr /></div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\t<tbody>\t\t<tr>\t\t\t<td style=\"width: 115px; vertical-align: top\">\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">II.iii.2.D.1.b<a id=\"1b\" name=\"1b\">.</a> Considering Evidence of VA or MTF Examination or Hospitalization Occurring on or After March 24, 2015</span></span></h3>\t\t\t</td>\t\t\t<td style=\"width: 15px; vertical-align: top\"></td>\t\t\t<td style=\"width: 516px\">\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">If unsolicited VA or MTF medical evidence shows treatment, but not hospitalization over 21 days on or after March 24, 2015, do not establish an end product (EP) to control receipt of this evidence.&nbsp; Ensure the evidence is associated with the beneficiary\u2019s claim folder, as this evidence may be utilized for effective date purposes if a formal claim or ITF is received within one year of the date of treatment.</span></span></span></span></div>\t\t\t<div></div>\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\"><strong><em>Important</em></strong>:&nbsp; When VA or MTF medical evidence was requested in association with a prior claim but was received after a decision was made, follow the procedures in <a class=\"eGainArticleLink\" articleid=\"554400000174858\" articlename=\"M21-1, Part II, Subpart i, Chapter 2, Section A - Process Overview for Screening Mail\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174858?portalId=554400000001018&usertype=customer&\">M21-1, Part II, Subpart i, 2.A.5</a> for handling late-flowing, solicited mail.&nbsp;</span></span></span></span></div>\t\t\t<div></div>\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\"><strong><em>Example</em></strong>:&nbsp; Veteran is SC for diabetes mellitus type 2 at 10 percent due to a restricted diet.&nbsp; A VA medical center (VAMC) treatment report dated June 10, 2015, shows a physician prescribed oral medication as part of the diabetic treatment plan.&nbsp; On March 1, 2016, the Veteran submits an ITF for compensation benefits.&nbsp; On September 20, 2016, the Veteran submits a claim for an increase in diabetes mellitus type 2.&nbsp; The Veteran\u2019s</span></span></span></span></div>\t\t\t<ul>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">date of claim (DOC) is September 20, 2016</span></span></span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">active ITF date is March 1, 2016, and</span></span></span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">effective date of increase is June 10, 2015.</span></span></span></span></div>\t\t\t\t</li>\t\t\t</ul>\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">An ITF for compensation benefits was received within one year of the treatment warranting an increased evaluation.&nbsp; The Veteran submitted a complete compensation claim within a year of the VA receiving the active ITF.</span></span></span></span></div>\t\t\t</td>\t\t</tr>\t</tbody></table><div style=\"margin-left: 85pt\"><hr /></div><div></div><div></div><h2><span style=\"font-size: 14px\"><span style=\"font-family: arial , helvetica , sans-serif\">&nbsp;</span></span><strong><span style=\"font-size: 16px\"><span style=\"font-family: arial , helvetica , sans-serif\">2<a id=\"2\" name=\"2\">.</a>&nbsp; Claims Based on Reports of Examination or Hospitalization Prior to March 24, 2015</span></span></strong></h2><p>&nbsp;<br />&nbsp;</p><div style=\"margin-left: 1.2in\"><hr /></div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\t<tbody>\t\t<tr>\t\t\t<td style=\"width: 115px; vertical-align: top\">\t\t\t<h3><strong><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">Introduction</span></span></strong></h3>\t\t\t</td>\t\t\t<td style=\"height: 8px; width: 15px\"></td>\t\t\t<td style=\"width: 516px\">\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">This topic contains information on reviewing reports of examination or hospitalization at VA facilities, MTFs, or private healthcare facilities occurring prior to March 24, 2015, to determine whether claims action is warranted, including</span></span></div>\t\t\t<ul>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><a href=\"#2a\"><span style=\"font-size: 14px\">accepting a report of VA or MTF examination or hospitalization dated prior to March 24, 2015, as a claim</span></a></span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><a href=\"#2b\"><span style=\"font-size: 14px\">establishing a claim based on VA medical treatment prior to March 24, 2015,</span></a> and</span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 14px\"><a href=\"#2c\">accepting evidence of private examination or hospitalization occurring prior to March 24, 2015</a>.</span></span></span></div>\t\t\t\t</li>\t\t\t</ul>\t\t\t</td>\t\t</tr>\t</tbody></table><div style=\"margin-left: 1.2in\"><hr /></div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\t<tbody>\t\t<tr>\t\t\t<td style=\"width: 115px; vertical-align: top\">\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><strong><span style=\"font-size: 14px\">Change Date</span></strong></span></h3>\t\t\t</td>\t\t\t<td style=\"height: 9px; width: 15px; vertical-align: top\"></td>\t\t\t<td style=\"width: 516px\">\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">June 24, 2021</span></span></div>\t\t\t</td>\t\t</tr>\t</tbody></table><div style=\"margin-left: 1.2in\"><hr /></div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\t<tbody>\t\t<tr>\t\t\t<td style=\"width: 115px; vertical-align: top\">\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">II.iii.2.D.2.a<a id=\"2a\" name=\"2a\">.</a>&nbsp; Accepting a Report of VA or MTF&nbsp;Examination or Hospitalization Dated Prior to March 24, 2015, as a Claim </span></span></h3>\t\t\t</td>\t\t\t<td style=\"width: 15px; vertical-align: top\"></td>\t\t\t<td style=\"width: 516px; vertical-align: top\">\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">Evidence of examination or hospitalization in a VA facility or MTF (also known as uniformed service facility) occurring before March 24, 2015, is an informal claim for</span></span></span></span></div>\t\t\t<ul>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">an increased disability rating for an SC disability, or</span></span></span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">pension, when entitlement to pension was previously denied based on the absence of evidence of P&amp;T disability.</span></span></span></span></div>\t\t\t\t</li>\t\t\t</ul>\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\"><strong><em>Note</em></strong>:&nbsp; A notice of hospitalization may <em>not</em> suffice as an informal claim if a Veteran with an SC disability(ies) is hospitalized for a disability for which service connection has not been established.</span></span></span></span></div>\t\t\t</td>\t\t</tr>\t</tbody></table><div style=\"margin-left: 85pt\"><hr /></div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\t<tbody>\t\t<tr>\t\t\t<td style=\"width: 115px; vertical-align: top\">\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">II.iii.2.D.2.b<a id=\"2b\" name=\"2b\">.</a>&nbsp; Establishing a Claim Based on VA Medical Treatment Prior to March 24, 2015</span></span></h3>\t\t\t</td>\t\t\t<td style=\"width: 15px; vertical-align: top\"></td>\t\t\t<td style=\"width: 516px\">\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">Follow the steps in the table below if the VA medical evidence shows treatment prior to March 24, 2015, for</span></span></div>\t\t\t<ul>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">an SC disability, or</span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">manifestations of an SC disability.</span></span></div>\t\t\t\t</li>\t\t\t</ul>\t\t\t<div>\t\t\t<table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" summary=\"This is a step-action table.  Column 1 is the step number and column 2 provides instructions if VA medical evidence shows treatment prior to March 24, 2015 for an SC disability or manifestations of an SC disability.\">\t\t\t\t<thead>\t\t\t\t\t<tr>\t\t\t\t\t\t<th scope=\"col\" style=\"width: 59px\">\t\t\t\t\t\t<div style=\"text-align: center\"><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><strong>Step</strong></span></span></div>\t\t\t\t\t\t</th>\t\t\t\t\t\t<th scope=\"col\" style=\"width: 445px\">\t\t\t\t\t\t<div style=\"text-align: center\"><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><strong>Action</strong></span></span></div>\t\t\t\t\t\t</th>\t\t\t\t\t</tr>\t\t\t\t</thead>\t\t\t\t<tbody>\t\t\t\t\t<tr>\t\t\t\t\t\t<td style=\"width: 59px\">\t\t\t\t\t\t<div align=\"center\"><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">1</span></span></div>\t\t\t\t\t\t</td>\t\t\t\t\t\t<td style=\"width: 445px\">\t\t\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">Accept the date of admission for treatment, date of outpatient treatment, or date of examination for an SC disability as the&nbsp;DOC for increased evaluation.</span></span></div>\t\t\t\t\t\t</td>\t\t\t\t\t</tr>\t\t\t\t\t<tr>\t\t\t\t\t\t<td style=\"width: 59px\">\t\t\t\t\t\t<div align=\"center\"><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">2</span></span></div>\t\t\t\t\t\t</td>\t\t\t\t\t\t<td style=\"width: 445px\">\t\t\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">Establish and maintain control of the claim.</span></span></div>\t\t\t\t\t\t</td>\t\t\t\t\t</tr>\t\t\t\t</tbody>\t\t\t</table>\t\t\t</div>\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">&nbsp; </span></span>\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-family: arial, helvetica, sans-serif\"><strong><em>Important</em></strong>:&nbsp; If unsolicited VA medical evidence, other than reports of hospitalization, shows treatment on or after March 24, 2015, <em>do not</em> establish an EP to control for receipt of this evidence.&nbsp; No further action is needed other than ensuring that records submitted by a claimant are associated with the claims folder, as this evidence may be utilized for effective date purposes if a formal claim is received within one year of the date of treatment.&nbsp;</span></span></span></div>\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-family: arial, helvetica, sans-serif\">&nbsp;</span></span></span></div>\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-family: arial, helvetica, sans-serif\"><strong><em>References</em></strong>:&nbsp; For more information on</span></span></span></div>\t\t\t<ul>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">procedures for processing solicited or unsolicited mail, see <a class=\"eGainArticleLink\" articleid=\"554400000174858\" articlename=\"M21-1, Part II, Subpart i, Chapter 2, Section A - Process Overview for Screening Mail\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174858?portalId=554400000001018&usertype=customer&\">M21-1, Part II, Subpart i, 2.A.5.d</a></span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">circumstances in which it is appropriate to incorporate VA treatment records into the claims folder when not submitted by a claimant, see <a class=\"eGainArticleLink\" articleid=\"554400000014108\" articlename=\"M21-1, Part III, Subpart ii, Chapter 1, Section A - Requesting Evidence From Federal Record Custodians\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000014108?portalId=554400000001018&usertype=customer&\">M21-1, Part III, Subpart ii, 1.A.2.b, d, and h</a></span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-family: arial, helvetica, sans-serif\">the effective date for an increase in compensation, see </span></span></span></div>\t\t\t\t<ul>\t\t\t\t\t<li>\t\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-family: arial, helvetica, sans-serif\"><a href=\"http://www.ecfr.gov/cgi-bin/text-idx?SID=0bb4b9219d281ec2c411b2a5dc2e314b&amp;mc=true&amp;node=se38.1.3_1400&amp;rgn=div8\" target=\"_blank\">38 CFR 3.400(o)</a>, and</span></span></span></div>\t\t\t\t\t</li>\t\t\t\t\t<li>\t\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><a class=\"eGainArticleLink\" articleid=\"554400000180492\" articlename=\"M21-1, Part V, Subpart ii, Chapter 4, Section A - Effective Dates\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000180492?portalId=554400000001018&usertype=customer&\">M21-1, Part V, Subpart ii, 4.A.5</a></span></span></div>\t\t\t\t\t</li>\t\t\t\t</ul>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-family: arial, helvetica, sans-serif\">establishing a claim based on VA medical treatment prior to March 24, 2015, see historical <a href=\"http://www.ecfr.gov/cgi-bin/text-idx?SID=1b780b2c30613fbf044bcf8e86b6fc85&amp;pitd=20150101&amp;node=se38.1.3_1157&amp;rgn=div8\" target=\"_blank\">38 CFR 3.157(b)(1)</a></span></span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-family: arial, helvetica, sans-serif\">the characteristics of an informal clam received prior to March 24, 2015, see <a class=\"eGainArticleLink\" articleid=\"554400000174880\" articlename=\"M21-1, Part II, Subpart iii, Chapter 2, Section H - Historical Guidance on Formal Applications and Informal Claims Received Prior to March 24, 2015\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174880?portalId=554400000001018&usertype=customer&\">M21-1, Part II, Subpart iii, 2.H.1</a></span></span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-family: arial, helvetica, sans-serif\">accepting medical evidence from an MTF as an informal claim prior to March 24, 2015, see <a href=\"#2a\">M21-1, Part II, Subpart iii, 2.D.2.a</a>, and</span></span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-family: arial, helvetica, sans-serif\">reviewing a report of hospitalization at a VA hospital or MTF dated on or after March 24, 2015, see <a href=\"#1a\">M21-1, Part II, Subpart iii, 2.D.1.a</a>.</span></span></span></div>\t\t\t\t</li>\t\t\t</ul>\t\t\t</div>\t\t\t</td>\t\t</tr>\t</tbody></table><div><div style=\"margin-left: 85pt\"><hr /></div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\t<tbody>\t\t<tr>\t\t\t<td style=\"width: 115px; vertical-align: top\">\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><strong><span style=\"font-size: 14px\">II.iii.2.D.2.c<a id=\"2c\" name=\"2c\">.</a>&nbsp; Accepting Evidence of Private Examination or Hospitalization Occurring Prior to March 24, 2015</span></strong></span></span></span></h3>\t\t\t</td>\t\t\t<td style=\"width: 15px; vertical-align: top\"></td>\t\t\t<td style=\"width: 516px\">\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">Private medical evidence may be accepted as a claim if</span></span></span></span></div>\t\t\t<ul>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">it shows treatment for an SC disability or manifestations of an SC disability prior to March 24, 2015</span></span></span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">it shows a reasonable probability of entitlement to a benefit, and</span></span></span></span></div>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">it was received by VA prior to March 24, 2015.</span></span></span></span></div>\t\t\t\t</li>\t\t\t</ul>\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\"><strong><em>Note</em></strong>:&nbsp; Once a claim is established, refer it for development or rating activity as necessary.</span></span></span></span></div>\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">&nbsp;</span></span></span></span></div>\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\"><strong><em>References</em></strong>:&nbsp; For more information on</span></span></span></span></div>\t\t\t<ul>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">the effective date for an increase in compensation, see </span></span></span></span></div>\t\t\t\t<ul>\t\t\t\t\t<li>\t\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\"><a href=\"http://www.ecfr.gov/cgi-bin/text-idx?SID=0bb4b9219d281ec2c411b2a5dc2e314b&amp;mc=true&amp;node=se38.1.3_1400&amp;rgn=div8\" target=\"_blank\">38 CFR 3.400(o)</a>, and</span></span></span></span></div>\t\t\t\t\t</li>\t\t\t\t\t<li>\t\t\t\t\t<div><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\"><a class=\"eGainArticleLink\" articleid=\"554400000180492\" articlename=\"M21-1, Part V, Subpart ii, Chapter 4, Section A - Effective Dates\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000180492?portalId=554400000001018&usertype=customer&\">M21-1, Part V, Subpart ii, 4.A.5</a>, and</span></span></div>\t\t\t\t\t</li>\t\t\t\t</ul>\t\t\t\t</li>\t\t\t\t<li>\t\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">establishing a clam based on private medical treatment prior to March 24, 2015, see historical <a href=\"http://www.ecfr.gov/cgi-bin/text-idx?SID=1b780b2c30613fbf044bcf8e86b6fc85&amp;pitd=20150101&amp;node=se38.1.3_1157&amp;rgn=div8\" target=\"_blank\">38 CFR 3.157(b)(2)</a>.</span></span></span></span></div>\t\t\t\t</li>\t\t\t</ul>\t\t\t</td>\t\t</tr>\t</tbody></table><div style=\"margin-left: 1.2in\"><div><hr /></div></div><div></div><div style=\"text-align: right\"><span style=\"font-size: 11px\"><span style=\"font-family: arial , helvetica , sans-serif\"><a class=\"eGainArticleLink\" articleid=\"554400000174875\" articlename=\"M21-1, Part II, Subpart iii, Chapter 2, Section C - Claims for Increase\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174875?portalId=554400000001018&usertype=customer&\">&lt;-- Previous Section</a>&nbsp;&nbsp;<a class=\"eGainArticleLink\" articleid=\"554400000174877\" articlename=\"M21-1, Part II, Subpart iii, Chapter 2, Section E - Incorrectly Established Claims\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174877?portalId=554400000001018&usertype=customer&\">Next Section--&gt;</a></span></span></div><span style=\"font-family: arial , helvetica , sans-serif\"><a href=\"#top\"><span style=\"font-size: 11px\">To Top</span></a></span><div></div></div>",
