{
 "name": "M21-1, Part VIII, Subpart i, Chapter 3, Section E - Authorization Issues for Chapter 18 Benefits",
 "content": "<p style=\"text-align:right\"><span style=\"font-size:11px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a class=\"eGainArticleLink\" articleid=\"554400000177431\" articlename=\"M21-1, Part VIII, Subpart i, Chapter 3, Section D - Rating\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000177431?portalId=554400000001018&usertype=customer&\">&lt;-- Previous Section</a>&nbsp;&nbsp;<a class=\"eGainArticleLink\" articleid=\"554400000177434\" articlename=\"M21-1, Part VIII, Subpart ii, Chapter 1, Section A - General Information on Presumptive Service Connection (SC) for Persian Gulf Veterans\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000177434?portalId=554400000001018&usertype=customer&\">Next Section --&gt;</a></span></span></p>\n\n<h2><a id=\"top\" name=\"top\"><span style=\"font-size:16px\"><span style=\"font-family:arial,helvetica,sans-serif\">Overview</span></span></a></h2>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">In This Section</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">This section contains the following topics:</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:491px\" summary=\"Column 1 has the topic number and column 2 has the topic title.\">\n\t\t\t\t<thead>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<th scope=\"col\" style=\"width: 77px\">\n\t\t\t\t\t\t<div style=\"text-align:center\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong>Topic</strong></span></span></div>\n\t\t\t\t\t\t</th>\n\t\t\t\t\t\t<th scope=\"col\" style=\"width: 432px\">\n\t\t\t\t\t\t<div style=\"text-align:center\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong>Topic Name</strong></span></span></div>\n\t\t\t\t\t\t</th>\n\t\t\t\t\t</tr>\n\t\t\t\t</thead>\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"width:77px\">\n\t\t\t\t\t\t<div align=\"center\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">1</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td style=\"width:432px\">\n\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:Arial,Helvetica,sans-serif\"><a href=\"#1\">Effective Date for Reductions and Terminations</a></span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"width:77px\">\n\t\t\t\t\t\t<div align=\"center\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">2</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td style=\"width:432px\">\n\t\t\t\t\t\t<div><a href=\"#2\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Processing Awards and Denials</span></span></a></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\n\t\t\t<div></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<p><br />\n&nbsp;</p>\n\n<h2><span style=\"font-size:16px\"><span style=\"font-family:arial,helvetica,sans-serif\">&nbsp;1<a id=\"1\" name=\"1\">.</a>&nbsp; Effective Date for Reductions and Terminations</span></span></h2>\n\n<p><br />\n&nbsp;</p>\n\n<div style=\"margin-left:100pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Introduction</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">This topic contains information on the effective date for Chapter 18 benefits, including the effective date for</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#1a\">reduction of Chapter 18 benefits</a>, and</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#1b\">termination of Chapter 18 benefits</a>.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Change Date</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">&nbsp;May 14, 2015</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">VIII.i.3.E.1.a<a id=\"1a\" name=\"1a\">.</a>&nbsp; Effective Date for Reduction of Chapter 18 Benefits</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Whenever it is necessary to reduce&nbsp;or discontinue a monthly allowance, generally, reduce or discontinue based on the facts found, except as provided in <a href=\"https://www.ecfr.gov/current/title-38/section-3.105\" target=\"_blank\">38 CFR 3.105(g)</a>, and <a href=\"https://www.ecfr.gov/current/title-38/section-3.114\" target=\"_blank\">38 CFR 3.114(b)</a>.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">The table below provides information to determine the correct effective date of a reduction or discontinuance.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:510px\" summary=\"This is an If-Then table.  Column 1 provides the criteria and column 2 provides the actions to take to determine the correct effective date of a reduction or discontinuation.\">\n\t\t\t\t<thead>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<th scope=\"col\" style=\"width: 246px\">\n\t\t\t\t\t\t<div style=\"text-align:left\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong>If benefits were paid erroneously due to ...</strong></span></span></div>\n\t\t\t\t\t\t</th>\n\t\t\t\t\t\t<th scope=\"col\" style=\"width: 264px\">\n\t\t\t\t\t\t<div style=\"text-align:left\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong>Then the effective date of the reduction or discontinuance&nbsp;is the date of ...</strong></span></span></div>\n\t\t\t\t\t\t</th>\n\t\t\t\t\t</tr>\n\t\t\t\t</thead>\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"width:246px\">\n\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">beneficiary error</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td style=\"width:264px\">\n\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">the erroneous award.</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"width:246px\">\n\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Department of Veterans Affairs administrative error</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td style=\"width:264px\">\n\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">last payment.</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong><em>Reference</em></strong>:&nbsp; For more information on resumption of discontinued benefits under <a href=\"https://www.law.cornell.edu/uscode/text/38/part-II/chapter-18\" target=\"_blank\">38 U.S.C. Chapter 18</a>, see <a href=\"https://www.ecfr.gov/current/title-38/section-3.158\" target=\"_blank\">38 CFR 3.158</a>.&nbsp;</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:1.2in\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">VIII.i.3.E.1.b<a id=\"1b\" name=\"1b\">.</a>&nbsp; Effective Date for Termination of Chapter 18 Benefits</span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">In the event of death, discontinue Chapter 18 benefits on the last day of the month <em>before </em>the month in which the child died.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong><em>Note</em></strong>:&nbsp; Handle abandoned claims for Chapter 18 benefits in the same manner as for compensation, pension, or Dependency and Indemnity Compensation.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong><em>Reference</em></strong>:&nbsp; For more information on the effective date for termination of benefits, see <a href=\"https://www.ecfr.gov/current/title-38/section-3.503\" target=\"_blank\">38 CFR 3.503(b)</a>.</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<p><br />\n&nbsp;</p>\n\n<h2><span style=\"font-size:16px\"><span style=\"font-family:arial,helvetica,sans-serif\">2<a id=\"2\" name=\"2\">.</a>&nbsp; Processing Awards and Denials</span></span></h2>\n\n<p><br />\n&nbsp;</p>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Introduction</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">This topic contains information on processing awards and denials of Chapter 18 monetary allowances, including</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#2a\">description of the final stage in the Chapter 18 claims process</a></span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#2b\">roles and responsibilities for processing Chapter 18 awards and denials</a>, and</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#2c\">award and denial process for Chapter 18 claims</a></span></span><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Change Date</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">December 31, 2019</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:1.2in\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">VIII.i.3.E.2.a<a id=\"2a\" name=\"2a\">.</a>&nbsp; Description of the Final Stage in the Chapter 18 Claims Process</span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">The final stage in the Chapter 18 claims process is to promulgate the rating decision or prepare an administrative denial and notify the claimant of the decision.</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:1.2in\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">VIII.i.3.E.2.b<a id=\"2b\" name=\"2b\">.</a>&nbsp; Roles and Responsibilities for Processing Chapter 18 Awards and Denials</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">The authorization activity is responsible for processing awards and denials.</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">VIII.i.3.E.2.c<a id=\"2c\" name=\"2c\">.</a>&nbsp; Award and Denial Process for Chapter 18 Claims</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; vertical-align:top; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">The processing of Chapter 18 awards is presently accomplished using the Veterans Benefits Management System.</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:1.2in\">\n<hr /></div>\n\n<div style=\"margin-left:1.2in\"></div>\n\n<p style=\"text-align:right\"><span style=\"font-size:11px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a class=\"eGainArticleLink\" articleid=\"554400000177431\" articlename=\"M21-1, Part VIII, Subpart i, Chapter 3, Section D - Rating\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000177431?portalId=554400000001018&usertype=customer&\">&lt;-- Previous Section</a>&nbsp;&nbsp;<a class=\"eGainArticleLink\" articleid=\"554400000177434\" articlename=\"M21-1, Part VIII, Subpart ii, Chapter 1, Section A - General Information on Presumptive Service Connection (SC) for Persian Gulf Veterans\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000177434?portalId=554400000001018&usertype=customer&\">Next Section --&gt;</a></span></span></p>\n\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#top\"><span style=\"font-size:11px\">To Top</span></a></span></p>\n",
