{
 "name": "M21-1, Part XIV, Chapter 1 - General Information on Matching Programs",
 "content": "<div>\n<div style=\"text-align: right\">\n<div><span style=\"font-size:11px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><a class=\"eGainArticleLink\" articleid=\"554400000173815\" articlename=\"M21-1, Part XIII, Subpart ii, Chapter 5, Section C - Information Requests for Research Purposes\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000173815?portalId=554400000001018&usertype=customer&\">&lt;-- Previous Section</a> <a class=\"eGainArticleLink\" articleid=\"554400000173301\" articlename=\"M21-1, Part XIV, Chapter 2, Section A - Social Security Income Match\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000173301?portalId=554400000001018&usertype=customer&\">&nbsp;Next Section --&gt;</a></span></span></div>\n</div>\n\n<div></div>\n\n<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><a id=\"Top\" name=\"Top\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 16px\">Overview</span></span></a></span></span></div>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<div style=\"width: 15px; vertical-align: top\"></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 115px; vertical-align: top\">\n\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">&nbsp;<span style=\"font-family:Arial,Helvetica,sans-serif;\">In This Chapter</span></span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height: 9px; width: 15px; vertical-align: top\"></td>\n\t\t\t<td style=\"width: 516px\">\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">This&nbsp;chapter contains the following topics:</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 510px\" summary=\"Column 1 has the topic number and column 2 has the topic title.\" width=\"419\">\n\t\t\t\t<thead>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<th scope=\"col\" style=\"width: 75px\">\n\t\t\t\t\t\t<div align=\"center\"><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong>Topic</strong></span></span></div>\n\t\t\t\t\t\t</th>\n\t\t\t\t\t\t<th scope=\"col\" style=\"width: 435px\">\n\t\t\t\t\t\t<div align=\"center\"><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong>Topic Name</strong></span></span></div>\n\t\t\t\t\t\t</th>\n\t\t\t\t\t</tr>\n\t\t\t\t</thead>\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"width: 75px\">\n\t\t\t\t\t\t<div align=\"center\"><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">1</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td style=\"width: 435px\">\n\t\t\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><a href=\"#1\">Purpose and Due Process Provisions of Matching Programs</a></span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"width: 75px\">\n\t\t\t\t\t\t<div align=\"center\"><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">2</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td style=\"width: 435px\">\n\t\t\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><a href=\"#2\">Jurisdiction Over Reports From Matching Programs</a></span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\n\t\t\t<div></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left: 85pt\">\n<hr />\n<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\">&nbsp;</span><br />\n&nbsp;</span></span></div>\n</div>\n</div>\n\n<h2><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 16px\">1<a id=\"1\" name=\"1\">.</a>&nbsp; Purpose and Due Process Provisions of Matching Programs</span></span></span></span></h2>\n\n<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\">&nbsp;</span><br />\n&nbsp;</span></span></div>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 115px; vertical-align: top\">\n\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">Introduction</span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height: 8px; width: 15px\">\n\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">&nbsp;</span></span></span></span></div>\n\t\t\t</td>\n\t\t\t<td style=\"width: 516px\">\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">This topic contains information on the purpose and due process provisions of matching programs, including</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><a href=\"#1a\">purpose of matching programs</a> </span></span></li>\n\t\t\t\t<li><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><a href=\"#1b\">due process provisions</a>, and </span></span></li>\n\t\t\t\t<li><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><a href=\"#1c\">fraud referrals</a>. </span></span></li>\n\t\t\t</ul>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 115px; vertical-align: top\">\n\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">Change Date</span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height: 8px; width: 15px\">\n\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">&nbsp;</span></span></span></span></div>\n\t\t\t</td>\n\t\t\t<td style=\"width: 516px\">\n\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\"><span style=\"font-family: arial, helvetica, sans-serif\">March 31, 2025</span></span></span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 115px; vertical-align: top\">\n\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">XIV.1.1.a<a id=\"1a\" name=\"1a\">.</a>&nbsp; Purpose of Matching Programs</span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height: 8px; width: 15px\">\n\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">&nbsp;</span></span></span></span></div>\n\t\t\t</td>\n\t\t\t<td style=\"width: 516px\">\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">The Department of Veterans Affairs (VA) receives information on a regular basis from several Federal agencies and compares it to information used to determine the status of VA beneficiaries.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">The matches identify cases where there are apparent contradictions between information contained in VA records and information furnished by other Federal agencies that affect entitlement.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong><em>Note</em></strong>: &nbsp;Regional offices will be informed of the dates the matches are conducted.</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 115px; vertical-align: top\">\n\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">XIV.1.1.b<a id=\"1b\" name=\"1b\">.</a>&nbsp; Due Process Provisions</span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height: 8px; width: 15px\">\n\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">&nbsp;</span></span></span></span></div>\n\t\t\t</td>\n\t\t\t<td id=\"cke_tmp_1570\" style=\"width: 516px\">\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Information derived from the matches may be used to adjust VA benefit payments.&nbsp; However, due process provisions are required since matching program information is third-party information.</span></span></div>\n\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">&nbsp;</span></span></div>\n\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong><em>Exceptions</em></strong>:&nbsp;&nbsp;The Social Security Administration (SSA) death master file match allows VA to</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">suspend the beneficiary\u2019s award, and</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">generate a contemporaneous notice of the suspension to the beneficiary\u2019s last known address.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong><em>References</em></strong>:&nbsp; For more information on</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">due process provisions, see <a class=\"eGainArticleLink\" articleid=\"554400000181468\" articlename=\"M21-1, Part I, Subpart i, Chapter 1, Section B - General Information on Due Process\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000181468?portalId=554400000001018&usertype=customer&\">M21-1, Part I,&nbsp;Subpart i, 1.B</a>, and </span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">the SSA death master file match, see <a class=\"eGainArticleLink\" articleid=\"554400000173303\" articlename=\"M21-1, Part XIV, Chapter 2, Section B - Social Security Death Master File (DMF) Match\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000173303?portalId=554400000001018&usertype=customer&\">M21-1, Part XIV, 2.B</a>.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 115px; vertical-align: top\">\n\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">XIV.1.1.c<a id=\"1c\" name=\"1c\">.</a>&nbsp; Fraud Referrals</span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height: 8px; width: 15px\"></td>\n\t\t\t<td style=\"width: 516px\">\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Consider a fraud referral in all instances of failure to report income or other entitlement factors under the provisions of <a class=\"eGainArticleLink\" articleid=\"554400000177993\" articlename=\"M21-1, Part X, Subpart iv, Chapter 3, Section A  - Fraud and Laboratory Analysis of Evidence\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000177993?portalId=554400000001018&usertype=customer&\">M21-1, Part X, Subpart iv, 3.A</a>.</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<div><br />\n<span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\">&nbsp;</span></span></div>\n\n<h2><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 16px\">2<a id=\"2\" name=\"2\">.</a>&nbsp; Jurisdiction Over Reports From Matching Programs&nbsp;&nbsp;&nbsp;</span></span></span></span></h2>\n\n<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">&nbsp;</span></span><br />\n&nbsp;</span></span></div>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 115px; vertical-align: top\">\n\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">Introduction</span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height: 8px; width: 15px\">\n\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">&nbsp;</span></span></span></span></div>\n\t\t\t</td>\n\t\t\t<td style=\"width: 516px\">\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">This topic contains information on jurisdiction over reports from matching programs, including </span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><a href=\"#2a\">pension management center (PMC) responsibility</a>, and</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><a href=\"#2b\">Veterans Service Center (VSC) and Benefit Eligibility Support Team (BEST) responsibility</a>.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 115px; vertical-align: top\">\n\t\t\t<h3><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size: 11px\"><span style=\"font-size: 14px\">Change Date</span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height: 8px; width: 15px\">\n\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">&nbsp;</span></span></span></span></div>\n\t\t\t</td>\n\t\t\t<td style=\"width: 516px\">\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">March 31, 2025</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 115px; vertical-align: top\">\n\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">XIV.1.2.a<a id=\"2a\" name=\"2a\">.</a>&nbsp; PMC Responsibility</span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height: 8px; width: 15px\">\n\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">&nbsp;</span></span></span></span></div>\n\t\t\t</td>\n\t\t\t<td style=\"width: 516px\">\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">The pension management centers (PMCs) in Philadelphia, St. Paul and Milwaukee are responsible for receiving and processing all reports from matching programs involving pension and Dependency and Indemnity Compensation recipients, including reports from:&nbsp;</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">&nbsp;Federal tax information match, including</span></span></div>\n\n\t\t\t\t<ul>\n\t\t\t\t\t<li>\n\t\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">upfront verification</span></span></div>\n\t\t\t\t\t</li>\n\t\t\t\t\t<li>\n\t\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">the income verification match, and</span></span></div>\n\t\t\t\t\t</li>\n\t\t\t\t\t<li>\n\t\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">post award audits (PAA)</span></span></div>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">SSA verification match</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">Social Security number&nbsp;match, and </span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">prison and fugitive felon match.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\n\t\t\t<div>\n\t\t\t<p><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong><em>Note</em></strong>:&nbsp; PMCs are not responsible for reviewing PAAs related to total disability based on individual unemployability.</span></span></p>\n\t\t\t<span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong><em>Reference</em></strong>:&nbsp; For more information on PMC procedures, see <a class=\"eGainArticleLink\" articleid=\"554400000181484\" articlename=\"M21-1, Part I, Subpart ii, Chapter 1, Section C - Pension Management Center (PMC) Procedures\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000181484?portalId=554400000001018&usertype=customer&\">M21-1, Part I, Subpart ii, 1.C</a>.</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 115px; vertical-align: top\">\n\t\t\t<h3><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">XIV.1.2.b<a id=\"2b\" name=\"2b\">.</a>&nbsp; VSC&nbsp;and BEST Responsibility&nbsp; </span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height: 8px; width: 15px\">\n\t\t\t<div><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 14px\">&nbsp;</span></span></span></span></div>\n\t\t\t</td>\n\t\t\t<td style=\"width: 516px\">\n\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">The Veterans Service Center or Benefit Eligibility Support Team of&nbsp;jurisdiction is responsible for receiving and processing reports from </span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">the SSA prison match, based on the location of the claims folder, and</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">matches involving compensation entitlement.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left: 85pt\">\n<hr /></div>\n\n<div style=\"margin-left: 85pt\">\n<div style=\"text-align: right\"></div>\n</div>\n\n<div>\n<div style=\"text-align: right\">\n<div>\n<div><span style=\"font-size:11px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><a class=\"eGainArticleLink\" articleid=\"554400000173815\" articlename=\"M21-1, Part XIII, Subpart ii, Chapter 5, Section C - Information Requests for Research Purposes\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000173815?portalId=554400000001018&usertype=customer&\">&lt;-- Previous Section</a> <a class=\"eGainArticleLink\" articleid=\"554400000173301\" articlename=\"M21-1, Part XIV, Chapter 2, Section A - Social Security Income Match\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000173301?portalId=554400000001018&usertype=customer&\">&nbsp;Next Section --&gt;</a></span></span></div>\n</div>\n\n<div>\n<p style=\"text-align: left;\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><span style=\"font-family: arial, helvetica, sans-serif\"><span style=\"font-size: 11px\"><a href=\"#top\"><span style=\"font-size: 11px\">To Top</span></a></span></span></span></span></p>\n</div>\n</div>\n</div>\n",
