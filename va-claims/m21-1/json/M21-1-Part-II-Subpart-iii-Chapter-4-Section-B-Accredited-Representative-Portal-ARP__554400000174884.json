{
 "name": "M21-1, Part II, Subpart iii, Chapter 4, Section B - Accredited Representative Portal (ARP)",
 "content": "<div style=\"text-align:right\"><span style=\"font-size:11px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a class=\"eGainArticleLink\" articleid=\"554400000174883\" articlename=\"M21-1, Part II, Subpart iii, Chapter 4, Section A - The Veterans Online Application (VONAPP) Direct Connect (VDC) Program and Department of Veterans Affairs (VA) Claims Submission Service Websites\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174883?portalId=554400000001018&usertype=customer&\">&lt;--Previous Section</a>&nbsp; <a class=\"eGainArticleLink\" articleid=\"554400000181424\" articlename=\"M21-1, Part III, Subpart i, Chapter 1, Section A - Establishing Veteran Status\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000181424?portalId=554400000001018&usertype=customer&\">Next Section--&gt;</a></span></span></div>\n\n<h2><a id=\"top\" name=\"top\"><span style=\"font-size:16px\"><span style=\"font-family:arial,helvetica,sans-serif\">Overview</span></span></a></h2>\n\n<p></p>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">In This Section</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">This section contains the&nbsp;topic&nbsp;\u201cIntroduction to ARP.\u201d</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<p style=\"margin-left:85.7pt\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">&nbsp;</span></span><br />\n&nbsp;</p>\n\n<h2><span style=\"font-size:16px\"><span style=\"font-family:arial,helvetica,sans-serif\">1<a id=\"1\" name=\"1\">.</a>&nbsp; Introduction to ARP</span></span></h2>\n\n<p style=\"margin-left:85.7pt\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span></p>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Introduction </span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">This topic contains information about ARP and how it interacts with Veterans Benefits Administration systems, including</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#1a\">purpose of ARP</a></span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#1b\">establishment of power of attorney (POA) through ARP</a></span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#1c\">failure to upload <em>VA Form 21-22, Appointment of Veterans Service Organization as Claimant\u2019s Representative</em>, for ARP-established POAs</a>, and</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#1d\">form submission via ARP</a>.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Change Date</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">September 24, 2026</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">II.iii.4.B.1.a<a id=\"1a\" name=\"1a\">.</a>&nbsp; Purpose of ARP</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">The Accredited Representative Portal (ARP) is a secure online tool for accredited representatives (including Veterans Service Organizations (VSOs), private attorneys, and agents) to efficiently establish representation and support claimants through the benefits claim process.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Through ARP these representatives can</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">digitally submit an intent to file</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">manage representation requests and agreements received online through a Department of Veterans Affairs (VA) claims submission service website&nbsp;</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">submit VA forms, documents, and supporting evidence to the Centralized Mail Portal</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">view submission history, and</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">review claimant details.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong><em>Important</em></strong>:&nbsp; With the exception of <a href=\"http://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\"><em>VA Form 21-22</em>,<em> Appointment of Veterans Service Organization as Claimant\u2019s Representative</em></a>, ARP <em>does not</em> generate VA forms. Accredited representatives must manually complete the forms and can subsequently submit the files via ARP.&nbsp; Select forms are eligible for data validation to ensure accurate form completion.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><em><strong>Notes</strong></em>:</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">The <a href=\"http://www.vba.va.gov/pubs/forms/VBA-21-22a-ARE.pdf\" target=\"_blank\"><em>VA Form 21-22a, Appointment of Individual As Claimant\u2019s Representative</em></a>, is <em>not</em> available for private attorneys and claims agents to manage through ARP.</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Before the ARP was implemented, accredited representatives used</span></span></div>\n\n\t\t\t\t<ul>\n\t\t\t\t\t<li>\n\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">eBenefits, which was decommissioned in December 2025, and</span></span></div>\n\t\t\t\t\t</li>\n\t\t\t\t\t<li>\n\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">the Stakeholders Enterprise Portal (SEP), which was decommissioned in January 2026.</span></span></div>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t\t</li>\n\t\t\t</ul>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><em><strong>References</strong></em>:&nbsp; For</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">form submission via ARP, see <a href=\"#1d\">M21-1, Part II, Subpart iii, 4.B.1.d</a></span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">more information on handling documents that fail to upload, see</span></span></div>\n\n\t\t\t\t<ul>\n\t\t\t\t\t<li>\n\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#1c\">M21-1, Part II, Subpart iii, 4.B.1.c</a>, and&nbsp;</span></span></div>\n\t\t\t\t\t</li>\n\t\t\t\t\t<li>\n\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a class=\"eGainArticleLink\" articleid=\"554400000174866\" articlename=\"M21-1, Part II, Subpart ii, Chapter 2, Section A - Folder Maintenance\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174866?portalId=554400000001018&usertype=customer&\" href=\"void(0)\">M21-1, Part II, Subpart ii, 2.A</a>, and</span></span></div>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">historical information on SEP and its functionality, see <em>Historical_M21-1_II_iii_4_SecB</em>.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">II.iii.4.B.1.b<a id=\"1b\" name=\"1b\">.</a>&nbsp; Establishment of POA Through ARP</span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Accredited representatives utilize ARP to complete the power of attorney (POA) establishment process once a claimant initiates the process in VA.gov.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">ARP functionality</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">allows accredited representatives to</span></span>\n\n\t\t\t\t<ul>\n\t\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">accept the representation request, and</span></span></li>\n\t\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">complete required fields on <em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\">VA Form 21-22</a></em></span></span></li>\n\t\t\t\t</ul>\n\t\t\t\t</li>\n\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">automatically update the corporate record with the POA information, and</span></span></li>\n\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">generate and upload the <em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\">VA Form 21-22</a></em> directly to the claimant\u2019s electronic claims folder (eFolder).</span></span></li>\n\t\t\t</ul>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">The table below outlines the process that occurs after a claimant selects an accredited representative as the POA through VA.gov.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" summary=\"This is a stage-description table.  Column 1 is the stage and column 2 describes the process.\">\n\t\t\t\t<thead>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<th scope=\"col\" style=\"vertical-align: top; width: 52px;\">\n\t\t\t\t\t\t<div align=\"center\" style=\"text-align:center\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong>Stage</strong></span></span></div>\n\t\t\t\t\t\t</th>\n\t\t\t\t\t\t<th scope=\"col\" style=\"vertical-align: top; width: 458px;\">\n\t\t\t\t\t\t<div align=\"center\" style=\"text-align:center\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong>Description</strong></span></span></div>\n\t\t\t\t\t\t</th>\n\t\t\t\t\t</tr>\n\t\t\t\t</thead>\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"vertical-align:top; width:52px\">\n\t\t\t\t\t\t<div align=\"center\" style=\"text-align:center\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">1</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td style=\"vertical-align:top; width:458px\">\n\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\"><em>VA Form 21-22</em></a> loads into the selected representative\u2019s portal for review.</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"vertical-align:top; width:52px\">\n\t\t\t\t\t\t<div align=\"center\" style=\"text-align:center\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">2</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td style=\"vertical-align:top; width:458px\">\n\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">The organization has sixty days to review the representation request.</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"vertical-align:top; width:52px\">\n\t\t\t\t\t\t<div align=\"center\" style=\"text-align:center\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">3</span></span></div>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td style=\"vertical-align:top; width:458px\">\n\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">ARP acts based on the representative\u2019s selection.&nbsp; If POA representation is</span></span></div>\n\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><em>rejected</em>, the claimant is notified of the rejected representation via VA Notify, or</span></span></li>\n\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><em>accepted</em>, the</span></span></div>\n\n\t\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\"><em>VA Form 21-22</em></a> is uploaded to the eFolder within minutes</span></span></div>\n\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">corporate database is immediately updated to include the newly elected POA information, and</span></span></div>\n\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">claimant is notified of the accepted representation via VA Notify.</span></span></div>\n\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</ul>\n\n\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong><em>Exception</em></strong>:&nbsp; If the representative does not approve or reject representation within sixty days, the</span></span></div>\n\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">request is removed from ARP due to inaction, and</span></span></div>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">claimant is notified through VA Notify.</span></span></div>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><em><strong>Important</strong></em>:&nbsp;</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Any automated POA established through ARP is valid for VA purposes and not subject to the requirements of paper <em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\">VA Form 21-22</a></em> processing.</span></span></li>\n\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">The <em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\">VA Form 21-22</a></em> will indicate electronic submission using the <em>Lighthouse via api.va.gov</em> watermark with the time and date of the submission.</span></span></li>\n\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">As mentioned in <a href=\"#1a\">M21-1, Part II, Subpart iii, 4.B.1.a</a>, private attorneys and claims agents are not able to use this process to manage POA establishment in ARP.</span></span></li>\n\t\t\t</ul>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><em><strong>Note</strong></em>:&nbsp; The signature blocks on the <em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\">VA Form 21-22</a></em> will format the signature text as indicated by</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">First Name + Last Name of claimant</span></span></li>\n\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">First Name + Last Name of the accredited representative, and</span></span></li>\n\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">the notation \u201cSigned via api.va.gov\u201d following each signature.</span></span></li>\n\t\t\t</ul>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">II.iii.4.B.1.c<a id=\"1c\" name=\"1c\">.</a>&nbsp; Failure to Upload VA Form 21-22 for ARP-Established POAs</span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">In rare circumstances, the <em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\">VA Form 21-22</a></em> may not correctly upload to the eFolder.&nbsp; Claims processors may presume that a POA was legitimately established using the ARP process if a review of the POA history in the Veterans Benefits Management System (VBMS) shows that the POA appointment update was performed by <em>VAGOVAPI</em>.</span></span></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong><em>&nbsp;</em></strong></span></span></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Claims processors must contact <a href=\"mailto:RepresentativePortalHelp@va.gov?subject=VA%20Form%2021-22%20failure%20to%20upload\">RepresentativePortalHelp@va.gov</a>&nbsp;if the <em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\">VA Form 21-22</a></em> is not of record and more than 48 hours have passed since the appointment of the POA via ARP.&nbsp; In this specific situation, do not follow the failure-to-upload procedure described in&nbsp;<a class=\"eGainArticleLink\" articleid=\"554400000174866\" articlename=\"M21-1, Part II, Subpart ii, Chapter 2, Section A - Folder Maintenance\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174866?portalId=554400000001018&usertype=customer&\" href=\"void(0)\">M21-1, Part II, Subpart ii, 2.A</a>.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">The email to the ARP help desk must </span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">identify the issue as a <em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\">VA Form 21-22</a></em> upload failure</span></span></li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">include the claimant\u2019s Integration Control Number (ICN), and</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">state the approximate date and time of the form submission.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong><em>Notes</em></strong>:</span></span></div>\n\n\t\t\t<ul>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Add a permanent&nbsp;Veteran-level note indicating the <em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\">VA Form 21-22</a></em> failed to upload and actions are being taken to recover the document.</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Upload a copy of the email to the claimant\u2019s eFolder.</span></span></div>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">The approximate date and time of submission can be determined by reviewing when the update was performed by <em>VAGOVAPI</em> in the POA history.</span></span></div>\n\t\t\t\t</li>\n\t\t\t</ul>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong><em>Reference</em></strong></span><span style=\"line-height:115%\">:&nbsp; For more information on locating the claimant\u2019s ICN or viewing POA information in VBMS, see the <em>VBMS Core User Guide</em>.</span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top; width:115px\">\n\t\t\t<h3><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">II.iii.4.B.1.d<a id=\"1d\" name=\"1d\">.</a>&nbsp; Form Submission via ARP</span></span></span></span></h3>\n\t\t\t</td>\n\t\t\t<td style=\"height:8px; width:15px\"></td>\n\t\t\t<td style=\"width:516px\">\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">ARP directs the accredited representative to the <a href=\"https://www.va.gov/forms/\">VA Forms publication webpage</a> to download the current version of VA forms. &nbsp;The representative completes the form and uploads the document to ARP.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\">Additional supporting documents (such as <em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-4138-ARE.pdf\" target=\"_blank\">VA Form 21-4138, Statement in Support of Claim</a></em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-4138-ARE.pdf\" target=\"_blank\">,</a> medical records, etc.) may be uploaded with the claim in different media formats. &nbsp;All documents uploaded through ARP are processed by VA mail automation services and uploaded to the claimant\u2019s eFolder.</span></span></div>\n\n\t\t\t<div></div>\n\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"font-family:arial,helvetica,sans-serif\"><strong><em><span style=\"line-height:115%\">Important</span></em></strong><span style=\"line-height:115%\">:&nbsp; When a claims processor becomes aware that documents (other than </span><em><a href=\"https://www.vba.va.gov/pubs/forms/VBA-21-22-ARE.pdf\" target=\"_blank\">VA Form 21-22</a></em><span style=\"line-height:115%\">) failed to upload properly, follow the failure-to-upload procedure described in&nbsp;<a class=\"eGainArticleLink\" articleid=\"554400000174866\" articlename=\"M21-1, Part II, Subpart ii, Chapter 2, Section A - Folder Maintenance\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174866?portalId=554400000001018&usertype=customer&\" href=\"void(0)\">M21-1, Part II, Subpart ii, 2.A</a>.</span></span></span></div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"margin-left:85pt\">\n<hr /></div>\n\n<div style=\"text-align:right\"><span style=\"font-size:11px\"><span style=\"font-family:arial,helvetica,sans-serif\"><a class=\"eGainArticleLink\" articleid=\"554400000174883\" articlename=\"M21-1, Part II, Subpart iii, Chapter 4, Section A - The Veterans Online Application (VONAPP) Direct Connect (VDC) Program and Department of Veterans Affairs (VA) Claims Submission Service Websites\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000174883?portalId=554400000001018&usertype=customer&\">&lt;--Previous Section</a>&nbsp; <a class=\"eGainArticleLink\" articleid=\"554400000181424\" articlename=\"M21-1, Part III, Subpart i, Chapter 1, Section A - Establishing Veteran Status\" href=\"https://www.knowva.ebenefits.va.gov/system/ws/v11/ss/article/554400000181424?portalId=554400000001018&usertype=customer&\">Next Section--&gt;</a></span></span></div>\n\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <span style=\"font-family:arial,helvetica,sans-serif\"><a href=\"#top\"><span style=\"font-size:11px\">To Top</span></a></span></p>\n",
